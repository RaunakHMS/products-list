<mvc:View
    controllerName="com.raunak.products.controller.App"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
>
    <Shell>
        <App>
            <Page
                title="{i18n>appTitle}"
                class="sapUiResponsiveContentPadding"
            >
                <!-- <core:Fragment type="XML" fragmentName="com.raunak.products.view.fragments.CreateProduct"/> -->
                <List
                    id="idProductList"
                    noDataText="{i18n>noProductsText}"
                    mode="Delete"
                    delete="onProductDelete"
                    items="{product>/items}"
                >
                    <headerToolbar>
                        <Toolbar>
                            <Title text="{i18n>listHeaderText}" />
                            <ToolbarSpacer />
                            <Button
                                icon="sap-icon://add"
                                press="onPressAddNewProduct"
                            />
                        </Toolbar>
                    </headerToolbar>
                    <ObjectListItem
                        title="{product>Name}"
                        number="{
                            parts: ['product>Price', 'product>Currency'],
                            type: 'sap.ui.model.type.Currency',
                            formatOptions: {
                                showMeasure: false
                            }
                        }"
                        numberUnit="{product>Currency}"
                        numberState="{= ${product>Price} > 20 ? 'Warning' : 'None' }"
                    >
                        <attributes>
                            <ObjectAttribute
                                title="Category"
                                text="{product>Category}"
                            />
                            <ObjectAttribute
                                title="Release Date"
                                text="{
                                    path:'product>ReleaseDate',
                                    type: 'sap.ui.model.type.Date',
                                    formatOptions: {
                                        source: { pattern: 'yyyy-MM-ddTHH:mm:ss.SSX' },
                                        style: 'short'
                                    }
                                }"
                            />
                            <ObjectAttribute 
                                visible="{= !!${product>Width} &amp;&amp; !!${product>Height} &amp;&amp; !!${product>Depth}}"
                                text="{product>Width} x {product>Height} x {product>Depth} cm"
                            />
                        </attributes>
                        <firstStatus>
                            <ObjectStatus
                                title="Stock"
                                text="{
                                    path: 'product>DiscontinuedDate',
                                    formatter: '.formatter.formatAvailabilityText'
                                }"
                                state="{
                                    path: 'product>DiscontinuedDate',
                                    formatter:'.formatter.formatAvailabilityState'
                                }"
                            />
                        </firstStatus>
                    </ObjectListItem>
                </List>
            </Page>
        </App>
    </Shell>
</mvc:View>
