<mvc:View
    controllerName="com.raunak.products.controller.App"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
>
    <Shell>
        <App>
            <Page
                title="{i18n>appTitle}"
                class="sapUiResponsiveContentPadding"
            >
                <form:SimpleForm
                    editable="true"
                    layout="ResponsiveGridLayout"
                    breakpointM="600"
                    breakpointL="1024"
                    breakpointXL="1440"
                >
                    <Label text="{i18n>productInputPlaceHolder}" />
                    <Input
                        id="idProductName"
                        placeholder="{i18n>productInputPlaceHolder}"
                    />
                    <Label text="{i18n>categoryDropDown}" />
                    <ComboBox
                        id="idCategory"
                        placeholder="{i18n>categoryDropDown}"
                    >
                        <items>
                            <core:Item
                                key=""
                                text=""
                            />
                            <core:Item
                                key="1"
                                text="Food"
                            />
                            <core:Item
                                key="2"
                                text="Beverages"
                            />
                            <core:Item
                                key="3"
                                text="Electronics"
                            />
                        </items>
                    </ComboBox>
                    <Label text="{i18n>productPricePlaceHolder}" />
                    <Input
                        id="idPrice"
                        type="Number"
                    />
                    <Label text="{i18n>producutReleaseDatePlaceHolder}" />
                    <DatePicker id="idReleaseDate" />
                    <Label text="{i18n>productDisconDate}" />
                    <DatePicker id="idDisconDate" />
                </form:SimpleForm>
                <Button
                    text="{i18n>createNewProductButton}"
                    press="onPressAddToCart"
                    type="Emphasized"
                />
                <List
                    id="idProductList"
                    headerText="{i18n>listHeaderText}"
                    noDataText="{i18n>noProductsText}"
                    mode="Delete"
                    delete="onProductDelete"
                />
            </Page>
        </App>
    </Shell>
</mvc:View>
