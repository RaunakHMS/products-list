<mvc:View
    controllerName="com.raunak.products.controller.App"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
>
    <Shell>
        <App>
            <Page
                title="{i18n>appTitle}"
                class="sapUiResponsiveContentPadding"
            >
                <!-- <core:Fragment type="XML" fragmentName="com.raunak.products.view.fragments.CreateProduct"/> -->
                <List
                    id="idProductList"
                    noDataText="{i18n>noProductsText}"
                    mode="Delete"
                    delete="onProductDelete"
                    items="{product>/items}"
                >
                    <headerToolbar>
                        <Toolbar>
                            <Title text="{i18n>listHeaderText}"></Title>
                            <ToolbarSpacer></ToolbarSpacer>
                            <Button icon="sap-icon://add" press="onPressAddNewProduct"></Button>
                        </Toolbar>
                    </headerToolbar>
                    <ObjectListItem title="{product>Name}" number="{product>Price}" 
                        numberUnit="{product>Currency}">
                        <attributes>
                            <ObjectAttribute title="Category" text="{product>Category}"></ObjectAttribute>
                            <ObjectAttribute title="Release Date" text="{product>ReleaseDate}"></ObjectAttribute>
                        </attributes>
                        <firstStatus>
                            <ObjectStatus 
                                title="Stock"
                                text="{product>DiscontinuedDate}"
                            ></ObjectStatus>
                        </firstStatus>
                    </ObjectListItem>
                </List>
            </Page>
        </App>
    </Shell>
</mvc:View>
