<mvc:View
    controllerName="com.raunak.products.controller.App"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
>
    <Shell>
        <App>
            <Page
                title="{i18n>appTitle}"
                class="sapUiResponsiveContentPadding"
            >
                <VBox>
                    <Input
                        id="idProductName"
                        placeholder="{i18n>productInputPlaceHolder}"
                        width="20rem"
                        maxLength="40"
                    />
                    <ComboBox
                        id="idCategory"
                        placeholder="{i18n>categoryDropDown}"
                    >
                        <items>
                            <core:Item
                                key=""
                                text=""
                            />
                            <core:Item
                                key="1"
                                text="Food"
                            />
                            <core:Item
                                key="2"
                                text="Beverages"
                            />
                            <core:Item
                                key="3"
                                text="Electronics"
                            />
                        </items>
                    </ComboBox>
                    <Input
                        id="idPrice"
                        placeholder="{i18n>productPricePlaceHolder}"
                        type="Number"
                    />
                    <DatePicker
                        id="idReleaseDate"
                        placeholder="{i18n>producutReleaseDatePlaceHolder}"
                    />
                    <DatePicker
                        id="idDisconDate"
                        placeholder="{i18n>productDisconDate}"
                    />
                </VBox>
                <Button
                    text="{i18n>createNewProductButton}"
                    press="onPressAddToCart"
                />
                <List
                    id="idProductList"
                    headerText="{i18n>listHeaderText}"
                    noDataText="{i18n>noProductsText}"
                    mode="Delete"
                    delete="onProductDelete"
                >
                    <items>
                        <ObjectListItem
                            title="S25 Ultra"
                            number="999"
                            numberUnit="INR"
                        >
                            <attributes>
                                <ObjectAttribute
                                    text="Category"
                                    title="Electronis"
                                />
                                <ObjectAttribute
                                    text="2025/09/02"
                                    title="Release Date"
                                />
                            </attributes>
                            <firstStatus>
                                <ObjectStatus
                                    title="Stock"
                                    text="Available"
                                    state="Success"
                                />
                            </firstStatus>
                        </ObjectListItem>
                    </items>
                </List>
            </Page>
        </App>
    </Shell>
</mvc:View>
